{
	"name": "narf",
	"version": "1.14.23",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build src/client",
		"coverage": "npm test -- --coverage",
		"coverage:client": "npm run test:client -- --coverage",
		"coverage:server": "npm run test:server -- --coverage",
		"e2e": "cypress run",
		"prepare": "husky || true",
		"start": "tsx src/server/index.ts",
		"test": "vitest run src",
		"test:client": "vitest run src/client",
		"test:server": "vitest run src/server",
		"transform": "tsx src/tasks/transform.ts"
	},
	"dependencies": {
		"@tootallnate/once": "^3.0.1",
		"@vitejs/plugin-vue": "^6.0.8",
		"axios": "^1.20.0",
		"base-x": "^5.0.1",
		"buffer": "^6.0.3",
		"compression": "^1.8.1",
		"connect-history-api-fallback": "^2.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"form-data": "^4.0.6",
		"http-terminator": "^3.2.0",
		"knex": "^3.3.0",
		"less": "^4.9.1",
		"node-cron": "^4.6.0",
		"qs": "^6.16.0",
		"remult": "^3.3.18",
		"semver": "^7.8.5",
		"sqlite3": "^6.0.1",
		"tar": "^7.5.22",
		"tough-cookie": "^6.0.2",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"uuid": "^14.0.2",
		"vite": "^8.2.2",
		"vite-plugin-html": "^3.2.2",
		"vite-plugin-singlefile": "^2.3.3",
		"vue": "^3.5.42",
		"vue-router": "^5.3.1",
		"vue-tsc": "^3.3.11",
		"vuex": "^4.1.0"
	},
	"devDependencies": {
		"@commitlint/config-conventional": "^21.2.2",
		"@flydotio/dockerfile": "^0.7.10",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@types/compression": "^1.8.1",
		"@types/connect-history-api-fallback": "^1.5.4",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node-cron": "^3.0.11",
		"@vitest/coverage-v8": "^5.0.0",
		"@vue/test-utils": "^2.5.0",
		"commitlint": "^21.2.2",
		"commitlint-config-gitmoji": "^2.3.1",
		"cypress": "^16.0.0",
		"gitmoji-cli": "^9.7.0",
		"globals": "^17.12.0",
		"happy-dom": "^20.14.3",
		"husky": "^9.1.7",
		"nano-staged": "^1.0.2",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-toml": "^2.0.6",
		"semantic-release": "^25.0.9",
		"semantic-release-gitmoji": "^1.6.9",
		"vitest": "^5.0.0",
		"vitest-mock-extended": "^5.1.1"
	},
	"nano-staged": {
		"*": [
			"prettier -luw",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"*.{cts,mjs,ts,vue}": [
			"oxlint --fix"
		]
	},
	"prettier": {
		"plugins": [
			"prettier-plugin-organize-imports",
			"prettier-plugin-toml"
		],
		"vueIndentScriptAndStyle": false
	},
	"engines": {
		"node": "^24"
	},
	"allowScripts": {
		"cypress@16.0.0": true,
		"esbuild@0.28.2": true,
		"sqlite3@6.0.1": true
	}
}
